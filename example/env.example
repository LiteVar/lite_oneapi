# Copy to example/.env, edit these values, then run protocol_smoke.sh.
# This .env file is read by the example script; the server does not load it.

# Local Lite OneAPI address (without a trailing /v1).
GATEWAY_URL=http://127.0.0.1:9517

# Provider API key. The smoke script sends it to the server for upstream passthrough.
API_KEY=replace-with-provider-api-key

# hy3 supports all three protocols on Tencent TokenHub.
MODEL=hy3
ADAPTER=hunyuan
PROTOCOL=all

# Optional upstream base URL override. Leave empty to use model_mapping.json.
# Example: https://your-openai-compatible-gateway.example.com/v1
BASE_URL=

# Optional upstream path overrides. Leave empty for the adapter's provider route.
CHAT_ENDPOINT=
RESPONSES_ENDPOINT=
MESSAGES_ENDPOINT=
MAX_TOKENS=128
